{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Create venv (.venv)",
      "type": "shell",
      "command": "python -m venv .venv",
      "problemMatcher": []
    },
    {
      "label": "Install requirements",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe -m pip install --upgrade pip wheel; .\\.venv\\Scripts\\pip.exe install -r requirements.txt",
      "options": {
        "shell": {
          "executable": "powershell.exe",
          "args": [
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-Command"
          ]
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Download Kaggle dataset",
      "type": "shell",
      "command": "kaggle datasets download -d benedictusjason/edible-and-poisonous-mushroom-classification -p data/mushrooms --unzip",
      "problemMatcher": []
    }
  ]
}